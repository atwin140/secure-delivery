{
  "name": "secure-delivery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "tsx src/server/main.ts",
    "local": "tsx scripts/local.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:browser": "playwright test",
    "benchmark": "tsx scripts/benchmark.ts",
    "migrate": "tsx scripts/admin.ts migrate",
    "preflight": "tsx scripts/admin.ts preflight",
    "sbom": "npm sbom --sbom-format cyclonedx > evidence/sbom.cdx.json",
    "format": "prettier --write src tests scripts docs *.ts *.json deploy/*.{yaml,json}"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.4",
    "jose": "6.2.12",
    "libsodium-wrappers-sumo": "0.8.4",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/adm-zip": "0.5.8",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "adm-zip": "0.6.1",
    "prettier": "3.8.3",
    "sodium-native": "5.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "yaml": "2.9.1"
  }
}
