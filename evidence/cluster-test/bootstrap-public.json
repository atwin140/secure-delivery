    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "delivery-service-ca",
        "namespace": "secure-delivery-test",
        "labels": {
          "app.kubernetes.io/part-of": "secure-delivery-test"
        },
        "annotations": {
          "service.beta.openshift.io/inject-cabundle": "true"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "test-registry",
        "namespace": "secure-delivery-test",
        "labels": {
          "app.kubernetes.io/part-of": "secure-delivery-test"
        }
      },
      "spec": {
        "accessModes": [
